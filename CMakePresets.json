{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SOURCETRACE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "clang-tidy",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/clang-tidy",
      "cacheVariables": {
        "SOURCETRACE_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "fuzz",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/fuzz",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "SOURCETRACE_BUILD_FUZZER": "ON",
        "SOURCETRACE_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "clang-tidy", "configurePreset": "clang-tidy" },
    { "name": "fuzz", "configurePreset": "fuzz" }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": { "outputOnFailure": true }
    }
  ]
}
